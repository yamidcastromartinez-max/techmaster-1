const def=()=>({versionSchema:2,config:{nombre:'TechMaster Solutions',nit:'',tel:'3243938956',wa:'3243938956',correo:'yamidcastromartinez@gmail.com',ceo:'Yamid Castro',dir:'',ciudad:'Cartagena',moneda:'COP',iva:19,prefQ:'COT',consQ:1,prefF:'FAC',consF:1,cierre:'Gracias por confiar en TechMaster Solutions.',terminos:'',web:'',instagram:'',facebook:'',logo:LOGO},clients:[],catalog:[],quotes:[],invoices:[],payments:[],movements:[]});
function migrate(d){const b=def();if(!d||typeof d!='object')return b;const o=Object.assign(b,d);o.config=Object.assign(b.config,d.config||{});
 if(!d.catalog&&d.servicios)o.catalog=d.servicios.map(s=>({...s,tipo:'servicio',precioCompra:0,iva:19}));
 if(!d.clients&&d.clientes)o.clients=d.clientes;if(!d.quotes&&d.cotizaciones)o.quotes=d.cotizaciones;
 o.catalog.forEach(c=>{c.tipo=c.tipo||'servicio';c.iva=c.iva??19;c.precioCompra=c.precioCompra||0;if(c.activo===undefined)c.activo=true});const z=def().config;['tel','wa','correo','ceo','logo'].forEach(k=>{if(!o.config[k])o.config[k]=z[k]});
 if(!o.seeded&&!o.catalog.length){o.catalog=seed();o.catalog.filter(c=>c.tipo=='producto').forEach(p=>o.movements.push({id:uid(),productoId:p.id,tipo:'Entrada',cantidad:p.stock,fecha:today(),motivo:'Stock inicial',referencia:''}))}
 o.seeded=true;o.versionSchema=2;return o}
