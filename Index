function saveDoc(){if(!D.cliente)return toast('Selecciona un cliente');if(!D.items.length)return toast('Agrega al menos un ítem');const q=D.kind=='q',o=build(),arr=q?DB.quotes:DB.invoices,x=arr.findIndex(a=>a.id==o.id);
 if(x>=0){const old=arr[x];if(!q){o.inventarioAplicado=old.inventarioAplicado;o.estadoFactura=old.estadoFactura=='Anulada'?'Anulada':o.estadoFactura}arr[x]=o}else{arr.push(o);q?DB.config.consQ++:DB.config.consF++}
 if(!q){if(['Emitida','Pagada'].includes(o.estadoFactura))applyInv(o);payState(o)}save();toast((q?'Cotización ':'Factura ')+o.numero+' guardada');D=null;go(q?'quotes':'invoices')}
function setQ(id,e){DB.quotes.find(q=>q.id==id).estado=e;save();render()}
function delQ(id){if(confirm('¿Eliminar cotización? El número no se reutilizará.')){DB.quotes=DB.quotes.filter(q=>q.id!=id);save();render()}}
/* ===== facturación ===== */
function toInvoice(id){const q=DB.quotes.find(x=>x.id==id);if(!q||q.facturaId)return;const now=new Date().toISOString(),f={id:uid(),numero:num('f'),fechaEmision:today(),fechaVencimiento:addDays(30),clienteId:q.clienteId,items:clone(q.items),dg:q.dg,subtotal:q.subtotal,descuento:q.descuento,baseGravable:q.baseGravable,iva:q.iva,total:q.total,pagado:0,saldo:q.total,estadoFactura:'Borrador',estadoPago:'Pendiente',responsable:q.responsable,formaPago:q.formaPago,observaciones:q.observaciones,terminos:q.terminos,cotizacionOrigen:q.numero,cotizacionId:q.id,inventarioAplicado:false,createdAt:now,updatedAt:now};DB.config.consF++;DB.invoices.push(f);q.facturaId=f.id;q.facturaNum=f.numero;save();toast(`${q.numero} convertida en ${f.numero} (borrador). Revísala y emítela.`);go('invoices')}
function emit(id){const f=DB.invoices.find(x=>x.id==id);const faltan=f.items.filter(i=>{const p=i.tipo=='producto'&&DB.catalog.find(c=>c.id==i.catId);return p&&(p.stock||0)<i.cant});if(faltan.length&&!confirm('Stock insuficiente en: '+faltan.map(i=>i.nombre).join(', ')+'. ¿Emitir de todos modos?'))return;f.estadoFactura='Emitida';applyInv(f);payState(f);save();render()}
function annul(id){const f=DB.invoices.find(x=>x.id==id);if(!confirm('¿Anular la factura '+f.numero+'?'))return;if(f.inventarioAplicado&&f.items.some(i=>i.tipo=='producto')&&confirm('¿Deseas devolver los productos al inventario?')){f.items.forEach(i=>{const p=i.tipo=='producto'&&DB.catalog.find(c=>c.id==i.catId);if(p){p.stock=(p.stock||0)+i.cant;mov(p.id,'Entrada',i.cant,'Reversión por anulación',f.numero)}});f.inventarioAplicado=false}f.estadoFactura='Anulada';save();render()}
/* ===== pagos ===== */
function payM(id){const fs=DB.invoices.filter(f=>['Emitida'].includes(f.estadoFactura));if(!fs.length)return toast('No hay facturas emitidas con saldo');openM(`<h2>Registrar pago</h2><div class="f"><div class="w"><label>Factura</label><select id="p_f">${fs.map(f=>`<option value="${f.id}" ${f.id==id?'selected':''}>${esc(f.numero)} · ${esc(cl(f.clienteId).nombre)} · saldo ${fmt(f.saldo)}</option>`).join('')}</select></div><div><label>Fecha</label><input id="p_d" type="date" value="${today()}"></div><div><label>Valor *</label><input id="p_v" type="number" min="0" step="any"></div><div><label>Método</label><select id="p_m">${['Efectivo','Transferencia bancaria','Nequi','Daviplata','Tarjeta débito','Tarjeta crédito','Otro'].map(m=>`<option>${m}</option>`).join('')}</select></div><div><label>Referencia</label><input id="p_r"></div><div class="w"><label>Observación</label><input id="p_o"></div></div><div class="mf"><button class="btn" onclick="closeM()">Cancelar</button><button class="btn p" onclick="savePay()">Registrar</button></div>`)}
function savePay(){const f=DB.invoices.find(x=>x.id==mf('p_f')),v=+mf('p_v');if(!(v>0))return toast('El valor debe ser mayor a 0');if(paid(f)+v>f.total&&!confirm('El pago supera el total de la factura. ¿Registrar de todos modos?'))return;DB.payments.push({id:uid(),facturaId:f.id,fecha:mf('p_d'),valor:v,metodo:mf('p_m'),referencia:mf('p_r'),observacion:mf('p_o')});payState(f);save();closeM();render()}
function delP(id){if(!confirm('¿Eliminar pago?'))return;const p=DB.payments.find(x=>x.id==id);DB.payments=DB.payments.filter(x=>x.id!=id);const f=DB.invoices.find(x=>x.id==p.facturaId);if(f){if(f.estadoFactura=='Pagada')f.estadoFactura='Emitida';payState(f)}save();render()}
/* ===== documentos: vista previa, PDF, WhatsApp ===== */
const norm=(k,o)=>({kind:k,numero:o.numero,fecha:o.fecha||o.fechaEmision,vence:o.validez||o.fechaVencimiento,cli:cl(o.clienteId),items:o.items,o,estado:o.estado||o.estadoFactura,pago:o.estadoPago&&pagoL(o)});
function docHTML(N){const c=DB.config,q=N.kind=='q',o=N.o,cc=N.cli,lg=`<img src="${c.logo||LOGO}" style="height:64px;border-radius:8px;display:block">`;
 const rows=N.items.map(i=>`<tr><td>${esc(i.codigo)}</td><td><b>${esc(i.nombre)}</b><br><span>${esc(i.desc)}</span></td><td>${i.cant}</td><td>${fmt(i.precio)}</td><td>${i.dsc||0}%</td><td>${i.iva||0}%</td><td>${fmt(i.cant*i.precio*(1-(i.dsc||0)/100))}</td></tr>`).join('');
 const row=(l,v)=>`<div><span>${l}</span><span>${v}</span></div>`;
 return `<div class="doc" id="docEl"><div class="dh ${q?'dq':'df'}"><div class="dl">${lg}<div><div class="dn">${esc(c.nombre)}</div><div>NIT ${esc(c.nit)}</div><div>${esc(c.tel)} · ${esc(c.correo)}</div><div>${esc(c.dir)} ${esc(c.ciudad)}</div></div></div><div class="dt"><div class="tt">${q?'COTIZACIÓN':'FACTURA DE VENTA'}</div><div class="nm">${esc(N.numero)}</div><div>${q?'Fecha':'Emisión'}: ${N.fecha}</div><div>${q?'Validez':'Vence'}: ${N.vence}</div>${o.cotizacionOrigen?`<div>Origen: ${esc(o.cotizacionOrigen)}</div>`:''}${o.responsable?`<div>Responsable: <b>${esc(o.responsable)}</b></div>`:''}</div></div>
 <div class="dc"><b>${q?'CLIENTE':'DATOS DEL CLIENTE'}</b><br><b style="font-size:13px;color:#1a2233;letter-spacing:0">${esc(cc.nombre)}</b> ${cc.empresa?'· '+esc(cc.empresa):''}<br>${esc(cc.nit)} · ${esc(cc.tel)} · ${esc(cc.correo)}<br>${esc(cc.dir)} ${esc(cc.ciudad)}</div>
 <table class="dtb"><thead><tr><th>Código</th><th style="text-align:left">${q?'Producto / Servicio':'Descripción'}</th><th>Cant.</th><th>${q?'Precio':'P. unitario'}</th><th>Desc.</th><th>IVA</th><th>Total</th></tr></thead><tbody>${rows}</tbody></table>
 <div class="dsum">${row('Subtotal',fmt(o.subtotal))}${row('Descuento','-'+fmt(o.descuento))}${row('IVA',fmt(o.iva))}<div class="tot"><span>TOTAL</span><span>${fmt(o.total)}</span></div></div>
 ${q?'':`<div class="dx"><b>PAGOS</b><br>Total: ${fmt(o.total)} · Pagado: ${fmt(o.pagado)} · Saldo: ${fmt(o.saldo)} · Estado: <b>${esc(N.pago||'')}</b> (${esc(N.estado)})</div>`}
 <div class="dx"><b>${q?'CONDICIONES':'FORMA DE PAGO Y OBSERVACIONES'}</b><br>${o.formaPago?'Forma de pago: '+esc(o.formaPago)+'<br>':''}${q&&o.entrega?'Entrega: '+esc(o.entrega)+'<br>':''}${q&&o.garantia?'Garantía: '+esc(o.garantia)+'<br>':''}${q?'Validez: '+N.vence+'<br>':''}${o.observaciones?esc(o.observaciones):''}${o.terminos?`<br><br><b>${q?'TÉRMINOS':'TÉRMINOS Y CONDICIONES'}</b><br>${esc(o.terminos).replace(/\n/g,'<br>')}`:''}</div>
 <div class="dfoot">${esc(c.cierre)}<br>${[c.tel,c.correo,c.web,c.instagram,c.facebook].filter(Boolean).map(esc).join(' · ')}${c.ceo?'<br>'+esc(c.ceo)+' · CEO · '+esc(c.nombre):''}</div></div>`}
let PV=null;
function prev(k,id){let o;if(id)o=(k=='q'?DB.quotes:DB.invoices).find(x=>x.id==id);else{if(!D.cliente||!D.items.length)return toast('Selecciona cliente y agrega ítems');o=build()}PV={k,o,id};
 openM(`<h2>Vista previa</h2><div class="pv">${docHTML(norm(k,o))}</div><div class="mf"><button class="btn" onclick="closeM()">Cerrar</button><button class="btn s" onclick="waPV()"><i class="fa-brands fa-whatsapp"></i> Enviar por WhatsApp</button><button class="btn p" onclick="pdf()"><i class="fa-solid fa-file-pdf"></i> Descargar PDF</button></div>`,1)}
async function pdf(){const el=$('#docEl'),c=await html2canvas(el,{scale:2,backgroundColor:'#fff'}),P=new window.jspdf.jsPDF('p','mm','a4'),m=8,iw=210-2*m,pp=Math.floor(c.width*(297-2*m)/iw);
 for(let y=0,p=0;y<c.height;y+=pp,p++){const h=Math.min(pp,c.height-y),s=document.createElement('canvas');s.width=c.width;s.height=h;s.getContext('2d').drawImage(c,0,y,c.width,h,0,0,c.width,h);if(p)P.addPage();P.addImage(s.toDataURL('image/jpeg',.95),'JPEG',m,m,iw,h*iw/c.width)}
 P.save(`${PV.o.numero}.pdf`)}
function sendWA(k,o){const c=cl(o.clienteId);let n=String(c.wa||c.tel||'').replace(/\D/g,'');if(!n)return toast('El cliente no tiene WhatsApp');if(n.length==10)n='57'+n;
 const m=`Hola ${c.nombre}, te compartimos la ${k=='q'?'cotización':'factura'} ${o.numero} por un valor de ${fmt(o.total)}.\n\nQuedamos atentos.\n\n${DB.config.nombre}`;window.open('https://wa.me/'+n+'?text='+encodeURIComponent(m),'_blank')}
const wa=(k,id)=>sendWA(k,(k=='q'?DB.quotes:DB.invoices).find(x=>x.id==id)),waPV=()=>sendWA(PV.k,PV.o);
$('#sideLogo').src=DB.config.logo||LOGO;nav();render();
</script></body></html>
