function calc(d){let sub=0,iv=0;const g=+d.dg||0;d.items.forEach(i=>{i.t=i.cant*i.precio*(1-(i.dsc||0)/100);sub+=i.t});const ds=sub*g/100;d.items.forEach(i=>iv+=i.t*(1-g/100)*(i.iva||0)/100);return{subtotal:sub,descuento:ds,baseGravable:sub-ds,iva:iv,total:sub-ds+iv}}
