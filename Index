 <div class="card" style="margin-top:16px"><h3>Accesos rápidos</h3><div class="acts"><button class="btn p" onclick="go('nq')"><i class="fa-solid fa-plus"></i> Nueva cotización</button><button class="btn p" onclick="go('nf')"><i class="fa-solid fa-plus"></i> Nueva factura</button><button class="btn" onclick="go('clients')">Clientes</button><button class="btn" onclick="go('catalog')">Catálogo</button></div></div>`},
